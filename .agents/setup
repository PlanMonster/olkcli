#!/usr/bin/env bash
set -euo pipefail

go_version="1.26.4"
golangci_lint_version="2.11.4"
local_bin="$HOME/.local/bin"
go_root="$HOME/.local/opt/go-$go_version"

case "$(uname -m)" in
  x86_64)
    arch="amd64"
    go_sha256="1153d3d50e0ac764b447adfe05c2bcf08e889d42a02e0fe0259bd47f6733ad7f"
    golangci_lint_sha256="200c5b7503f67b59a6743ccf32133026c174e272b930ee79aa2aa6f37aca7ef1"
    ;;
  aarch64)
    arch="arm64"
    go_sha256="ef758ae7c6cf9267c9c0ef080b8965f453d89ab2d25d9eb22de4405925238768"
    golangci_lint_sha256="3bcfa2e6f3d32b2bf5cd75eaa876447507025e0303698633f722a05331988db4"
    ;;
  *)
    echo "Unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

missing_packages=()
command -v curl >/dev/null 2>&1 || missing_packages+=(curl)
command -v git >/dev/null 2>&1 || missing_packages+=(git)
command -v make >/dev/null 2>&1 || missing_packages+=(make)
command -v gcc >/dev/null 2>&1 || missing_packages+=(gcc)
command -v tar >/dev/null 2>&1 || missing_packages+=(tar)

if ((${#missing_packages[@]})); then
  echo "Installing system packages: ${missing_packages[*]}"
  if ((EUID == 0)); then
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}" ca-certificates
  else
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}" ca-certificates
  fi
fi

mkdir -p "$local_bin" "$(dirname "$go_root")"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

if [[ ! -x "$go_root/bin/go" ]] || [[ "$($go_root/bin/go version)" != "go version go$go_version "* ]]; then
  echo "Installing Go $go_version"
  go_archive="go$go_version.linux-$arch.tar.gz"
  curl --fail --location --retry 3 --output "$tmp_dir/$go_archive" "https://go.dev/dl/$go_archive"
  echo "$go_sha256  $tmp_dir/$go_archive" | sha256sum --check --status
  rm -rf "$go_root"
  mkdir -p "$go_root"
  tar -xzf "$tmp_dir/$go_archive" --strip-components=1 -C "$go_root"
fi

ln -sfn "$go_root/bin/go" "$local_bin/go"
ln -sfn "$go_root/bin/gofmt" "$local_bin/gofmt"
export PATH="$go_root/bin:$local_bin:$PATH"

if [[ ! -x "$local_bin/golangci-lint" ]] || [[ "$("$local_bin/golangci-lint" version 2>/dev/null)" != *"version $golangci_lint_version "* ]]; then
  echo "Installing golangci-lint $golangci_lint_version"
  lint_archive="golangci-lint-$golangci_lint_version-linux-$arch.tar.gz"
  curl --fail --location --retry 3 --output "$tmp_dir/$lint_archive" \
    "https://github.com/golangci/golangci-lint/releases/download/v$golangci_lint_version/$lint_archive"
  echo "$golangci_lint_sha256  $tmp_dir/$lint_archive" | sha256sum --check --status
  tar -xzf "$tmp_dir/$lint_archive" -C "$tmp_dir"
  install -m 0755 "$tmp_dir/golangci-lint-$golangci_lint_version-linux-$arch/golangci-lint" \
    "$local_bin/golangci-lint"
fi

env_dir="$HOME/.config/amp/orb-env"
env_file="$env_dir/olkcli.sh"
mkdir -p "$env_dir"
cat >"$env_file" <<EOF
# Generated by olkcli's .agents/setup.
export PATH="$go_root/bin:$local_bin:\$PATH"
EOF

profile_marker="# olkcli orb toolchain"
touch "$HOME/.bash_profile"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile"; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# olkcli orb toolchain
if [[ -r "$HOME/.config/amp/orb-env/olkcli.sh" ]]; then
  source "$HOME/.config/amp/orb-env/olkcli.sh"
fi
EOF
fi

echo "Downloading Go module dependencies"
go mod download

echo "Orb setup complete"
go version
golangci-lint version | head -n 1
